# =======================================================
# Chatbot Provider: "ollama" (Local, offline, free) or "huggingface"
# =======================================================
LLM_PROVIDER=ollama

# =======================================================
# Local Ollama Configuration (No API Key Required!)
# =======================================================
OLLAMA_BASE_URL=http://localhost:11434
# Set to any model you downloaded in Ollama (e.g. llama3.2, llama3, mistral, qwen2.5, phi3, gemma2, deepseek-r1)
OLLAMA_MODEL=llama3.2

# =======================================================
# Hugging Face Configuration (Alternative)
# =======================================================
HUGGINGFACEHUB_API_TOKEN=
MODEL_REPO_ID=Qwen/Qwen2.5-7B-Instruct

# =======================================================
# Generation Parameters
# =======================================================
TEMPERATURE=0.7
MAX_NEW_TOKENS=512
TOP_P=0.95

# =======================================================
# Server Configuration
# =======================================================
HOST=127.0.0.1
PORT=8000
DEBUG=true
